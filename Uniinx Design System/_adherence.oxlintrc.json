{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/commerce/**",
              "components/core/**",
              "components/navigation/**",
              "ui_kits/uniinx-storefront/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Marcellus|Work Sans|Noto Serif Devanagari|Noto Serif Tamil|Noto Serif Telugu|Noto Serif Kannada|Noto Serif Bengali|Noto Serif Gujarati|Noto Serif Gurmukhi|Noto Serif Oriya|Noto Nastaliq Urdu))/i]",
        "message": "Font not provided by the design system. Available: Marcellus, Work Sans, Noto Serif Devanagari, Noto Serif Tamil, Noto Serif Telugu, Noto Serif Kannada, Noto Serif Bengali, Noto Serif Gujarati, Noto Serif Gurmukhi, Noto Serif Oriya, Noto Nastaliq Urdu."
      },
      {
        "selector": "JSXOpeningElement[name.name='BottomSheet'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|onClose|title|children|key|ref|className|style|children)$/]",
        "message": "<BottomSheet> doesn't accept that prop. Declared props: open, onClose, title, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|shape|font|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, tone, shape, font, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:dark|light|accent)$/]",
        "message": "<Button> tone must be one of 'dark' | 'light' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:pill|capsule)$/]",
        "message": "<Button> shape must be one of 'pill' | 'capsule'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='font'] > Literal[value!=/^(?:marcellus)$/]",
        "message": "<Button> font must be one of 'marcellus'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ClothTypeSelector'] > JSXAttribute > JSXIdentifier[name!=/^(?:garmentId|onGarmentChange|fabricId|onFabricChange|key|ref|className|style|children)$/]",
        "message": "<ClothTypeSelector> doesn't accept that prop. Declared props: garmentId, onGarmentChange, fabricId, onFabricChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='LanguageChipSelector'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|languages|size|key|ref|className|style|children)$/]",
        "message": "<LanguageChipSelector> doesn't accept that prop. Declared props: value, onChange, languages, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='LanguageChipSelector'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<LanguageChipSelector> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MobileTabBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:active|onNavigate|cartCount|key|ref|className|style|children)$/]",
        "message": "<MobileTabBar> doesn't accept that prop. Declared props: active, onNavigate, cartCount."
      },
      {
        "selector": "JSXOpeningElement[name.name='MobileTabBar'] > JSXAttribute[name.name='active'] > Literal[value!=/^(?:home|plp|cart)$/]",
        "message": "<MobileTabBar> active must be one of 'home' | 'plp' | 'cart'."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavLanguageSwitcher'] > JSXAttribute > JSXIdentifier[name!=/^(?:activeId|onSelect|wordmark|key|ref|className|style|children)$/]",
        "message": "<NavLanguageSwitcher> doesn't accept that prop. Declared props: activeId, onSelect, wordmark."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProductCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|label|price|width|height|onBuy|key|ref|className|style|children)$/]",
        "message": "<ProductCard> doesn't accept that prop. Declared props: image, label, price, width, height, onBuy."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
